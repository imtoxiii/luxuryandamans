# Luxury Andamans — Apache SEO + SPA config
# Canonical: https://luxuryandamans.com (no www, no trailing slash)
# Keep in sync with public/.htaccess (deployed copy).

DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Canonical host: HTTPS + non-www (must be first) ---
  RewriteCond %{HTTP_HOST} ^www\.luxuryandamans\.com$ [NC]
  RewriteRule ^ https://luxuryandamans.com%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://luxuryandamans.com%{REQUEST_URI} [L,R=301]

  # --- Legacy path redirects (HTTP 301, absolute HTTPS — avoid http:// Location) ---
  RewriteRule ^about/?$ https://luxuryandamans.com/guide [L,R=301]
  RewriteRule ^experiences/luxury-beach-resorts/?$ https://luxuryandamans.com/experiences/luxury-resorts [L,R=301]
  RewriteRule ^blog/undefined/?$ https://luxuryandamans.com/blog [L,R=301]
  RewriteRule ^blog/havelock-vs-neil-island-guide/?$ https://luxuryandamans.com/blog/havelock-vs-neil-island-guide-2026 [L,R=301]
  RewriteRule ^blog/andaman-7-day-itinerary/?$ https://luxuryandamans.com/blog/7-day-andaman-itinerary [L,R=301]
  RewriteRule ^blog/andaman-itinerary-7-days/?$ https://luxuryandamans.com/blog/7-day-andaman-itinerary [L,R=301]
  RewriteRule ^blog/andaman-best-time/?$ https://luxuryandamans.com/blog/best-time-to-visit-andaman [L,R=301]
  RewriteRule ^blog/best-time-visit-andaman/?$ https://luxuryandamans.com/blog/best-time-to-visit-andaman [L,R=301]
  RewriteRule ^blog/andaman-budget-guide/?$ https://luxuryandamans.com/blog/andaman-budget-travel-guide [L,R=301]
  RewriteRule ^blog/cheap-andaman-packages/?$ https://luxuryandamans.com/blog/andaman-budget-travel-guide [L,R=301]
  RewriteRule ^blog/andaman-scuba-guide/?$ https://luxuryandamans.com/blog/andaman-scuba-diving-guide [L,R=301]
  RewriteRule ^blog/andaman-scuba-prices-2025/?$ https://luxuryandamans.com/blog/andaman-scuba-prices-2026 [L,R=301]
  RewriteRule ^blog/andaman-top-things-to-do/?$ https://luxuryandamans.com/blog/andaman-top-things-to-do-2025 [L,R=301]
  RewriteRule ^blog/top-things-to-do-in-andaman/?$ https://luxuryandamans.com/blog/andaman-top-things-to-do-2025 [L,R=301]
  RewriteRule ^blog/top-things-to-do-andaman/?$ https://luxuryandamans.com/blog/andaman-top-things-to-do-2025 [L,R=301]
  RewriteRule ^blog/top-things-to-do-andaman-2026/?$ https://luxuryandamans.com/blog/andaman-top-things-to-do-2025 [L,R=301]
  RewriteRule ^blog/andaman-luxury-resorts-2025/?$ https://luxuryandamans.com/blog/andaman-luxury-resorts-2026 [L,R=301]
  RewriteRule ^blog/port-blair-one-day-plan/?$ https://luxuryandamans.com/blog/port-blair-one-day-itinerary [L,R=301]
  RewriteRule ^blog/best-beach-destination-india/?$ https://luxuryandamans.com/blog/best-beach-destinations-india [L,R=301]
  RewriteRule ^blog/havelock-island-guide/?$ https://luxuryandamans.com/blog/havelock-island-travel-guide-2026 [L,R=301]
  RewriteRule ^blog/port-blair-travel-guide/?$ https://luxuryandamans.com/blog/port-blair-travel-guide-2026 [L,R=301]
  RewriteRule ^blog/andaman-international-guide/?$ https://luxuryandamans.com/blog/andaman-islands-international-travel-guide-2026 [L,R=301]
  RewriteRule ^blog/andaman-solor-trip-guide/?$ https://luxuryandamans.com/blog/andaman-solo-trip-guide [L,R=301]
  RewriteRule ^blog/is-andaman-safe-2026/?$ https://luxuryandamans.com/blog/is-andaman-safe-for-tourists [L,R=301]
  RewriteRule ^blog/a-food-lovers-guide-to-andaman/?$ https://luxuryandamans.com/blog/andaman-food-guide [L,R=301]
  RewriteRule ^blog/andaman-vegetarian-food-guide-2026/?$ https://luxuryandamans.com/blog/vegetarian-food-in-andaman [L,R=301]
  RewriteRule ^blog/andaman-internet-connectivity-guide-2026/?$ https://luxuryandamans.com/blog/mobile-network-internet-in-andaman [L,R=301]
  RewriteRule ^blog/andaman-ferry-guide-2026/?$ https://luxuryandamans.com/blog/andaman-ferry-booking-guide [L,R=301]
  RewriteRule ^blog/andaman-family-itinerary-2026/?$ https://luxuryandamans.com/blog/andaman-family-itinerary [L,R=301]
  RewriteRule ^blog/family-friendly-andaman-kids/?$ https://luxuryandamans.com/blog/andaman-family-itinerary [L,R=301]
  RewriteRule ^blog/andaman-packing-list-checklist/?$ https://luxuryandamans.com/blog/what-to-pack-for-andaman-trip [L,R=301]
  RewriteRule ^blog/sustainable-packing-list-2026/?$ https://luxuryandamans.com/blog/what-to-pack-for-andaman-trip [L,R=301]
  RewriteRule ^blog/andaman-scuba-diving-2026/?$ https://luxuryandamans.com/blog/andaman-scuba-diving-guide [L,R=301]
  RewriteRule ^blog/scuba-diving-andaman-guide/?$ https://luxuryandamans.com/blog/andaman-scuba-diving-guide [L,R=301]
  RewriteRule ^blog/top-10-things-to-do-andaman-2025/?$ https://luxuryandamans.com/blog/andaman-top-things-to-do-2025 [L,R=301]
  RewriteRule ^blog/bali-vs-andaman-comparison/?$ https://luxuryandamans.com/blog/andaman-vs-bali [L,R=301]
  RewriteRule ^blog/best-time-visit-thailand/?$ https://luxuryandamans.com/blog/best-time-to-visit-andaman [L,R=301]
  RewriteRule ^blog/andaman-tourism-trends-2026/?$ https://luxuryandamans.com/blog/first-timers-guide-andaman-2026 [L,R=301]
  RewriteRule ^blog/hidden-andaman-facts-2026/?$ https://luxuryandamans.com/blog/first-timers-guide-andaman-2026 [L,R=301]
  RewriteRule ^blog/best-beach-award-2024/?$ https://luxuryandamans.com/blog/radhanagar-beach-guide-2026 [L,R=301]
  RewriteRule ^blog/new-ferry-services-2026/?$ https://luxuryandamans.com/blog/andaman-ferry-booking-guide [L,R=301]
  RewriteRule ^blog/island-tourism-festival-2026/?$ https://luxuryandamans.com/blog/first-timers-guide-andaman-2026 [L,R=301]
  RewriteRule ^blog/new-eco-resorts-andaman-2026/?$ https://luxuryandamans.com/blog/andaman-luxury-resorts-2026 [L,R=301]
  RewriteRule ^destinations/saddle-peak/?$ https://luxuryandamans.com/destinations/ross-smith-islands [L,R=301]
  RewriteRule ^destinations/north-andaman-destinations/?$ https://luxuryandamans.com/destinations/ross-smith-islands [L,R=301]

  # --- Strip trailing slash (except root) — matches sitemap + canonicals ---
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [L,R=301]

  # --- Prerendered directories: serve index.html without redirect ---
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # --- Existing files pass through ---
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # --- Unknown paths: stop rewriting so Apache returns a real HTTP 404 ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [L]
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType application/xml "access plus 1 hour"
  ExpiresByType text/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|eot|ico)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  Header always set X-Content-Type-Options nosniff
  Header always set X-Frame-Options DENY
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<FilesMatch "(^#.*#|\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op])|~)$">
  Require all denied
</FilesMatch>

<FilesMatch "^\.env">
  Require all denied
</FilesMatch>

ServerSignature Off
FileETag MTime Size

<IfModule mod_mime.c>
  AddType application/font-woff2 .woff2
  AddType application/font-woff .woff
  AddType image/webp .webp
</IfModule>
